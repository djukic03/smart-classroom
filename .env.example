# --- ENVIRONMENT VARIABLES ---

# --- App ---
APP_NAME="Smart Classroom"
DEBUG=false

# --- Database ---
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/db
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=db

# --- Security ---
SECRET_KEY=replace-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
TOKEN_TOUCH_INTERVAL_SECONDS=60
DEFAULT_DEVICE_NAME=nepoznat uređaj

# --- Merenja ---
MEASUREMENT_AGGREGATE_MIN_RANGE_HOURS=24

# --- Login and Register rate limiting ---
LOGIN_IP_ATTEMPT_LIMIT=20
LOGIN_IP_WINDOW_SECONDS=300
LOGIN_ACCOUNT_ATTEMPT_LIMIT=5
LOGIN_ACCOUNT_WINDOW_SECONDS=300
REGISTER_ATTEMPT_LIMIT=5
REGISTER_WINDOW_SECONDS=3600

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- MQTT auth ---
MQTT_USERNAME=user
MQTT_PASSWORD=password
MQTT_HOOK_ALLOWED_HOSTS=["replace-with-mosquitto-hostname"]

# --- MQTT client data ---
MQTT_HOST=replace-with-mosquitto-hostname
MQTT_PORT=8883
MQTT_CA_FILE=replace-with-path-to-ca.crt
MQTT_CLIENT_ID=replace-with-client-id
MQTT_KEEPALIVE_SECONDS=60
MQTT_RECONNECT_SECONDS=5
MQTT_CONSUMER_ENABLED=true
MQTT_CONFIG_QUEUE_SIZE=1000

# --- Reset lozinke ---
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_IP_ATTEMPT_LIMIT=5
PASSWORD_RESET_IP_WINDOW_SECONDS=3600
PASSWORD_RESET_ACCOUNT_ATTEMPT_LIMIT=3
PASSWORD_RESET_ACCOUNT_WINDOW_SECONDS=3600
FRONTEND_RESET_URL=http://localhost:3000/reset-password

# --- Slanje poruka ---
MAIL_BACKEND=console
MAIL_FROM=no-reply@smart-classroom.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# --- Detekcija anomalija ---
ANOMALY_DETECTION_ENABLED=true
ANOMALY_TRIGGER_SAMPLES=2
ANOMALY_CLEAR_SAMPLES=2
ANOMALY_HYSTERESIS_PERCENT=5.0
ANOMALY_NOTIFY_ENABLED=true
ANOMALY_NOTIFY_INTERVAL_SECONDS=30
ANOMALY_NOTIFY_BATCH=20

# --- Push notifikacije ---
PUSH_BACKEND=console
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_PUSH_BATCH_SIZE=100
PUSH_REQUEST_TIMEOUT_SECONDS=15
