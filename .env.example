# --- ENVIRONMENT VARIABLES ---

# --- App ---
APP_NAME="Smart Classroom"
DEBUG=true

# --- Database ---
# Host je `db` (naziv servisa u docker-compose.yaml), ne localhost.
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/db
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=db

# --- Security ---
SECRET_KEY=replace-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=console
